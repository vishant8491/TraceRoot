# Backend Environment Configuration for TraceRoot

# Application
APP_NAME=TraceRoot RCA Workspace
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# Groq API Configuration
# Get your API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database Configuration
# Primary target is PostgreSQL per assessment requirement:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/traceroot
# For local zero-setup dev when PostgreSQL is offline, system automatically supports:
# DATABASE_URL=sqlite+aiosqlite:///./traceroot.db

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
